# Copy to terraform.tfvars and fill in (Captain normally generates this for you).
# Secrets are NOT here: export them so they stay out of tfvars and state.
#
#   export B2_APPLICATION_KEY_ID=...      # an operator key that can create keys
#   export B2_APPLICATION_KEY=...         #   and manage notifications
#   export CAPTAIN_API_KEY=...            # your Captain API key
#   terraform init
#   terraform apply

sync_id     = "sync_REPLACE_ME"
bucket_name = "your-existing-b2-bucket"

# Optional. api_base defaults to Captain's production API; override only if
# Captain support points you at another environment (staging).
# api_base             = "https://api.captain.dev"
# key_duration_seconds = 7776000   # 90 days, for rotation. null = non-expiring.

# event_path defaults to "skip" because B2 Event Notifications are account-gated
# by Backblaze. Set to "enabled" only after Backblaze has turned the feature on
# for your account (see b2/NOTES.md).
# event_path = "skip"
